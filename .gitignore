# Terraform working directory and local state
**/.terraform/*
*.tfstate
*.tfstate.*
crash.log
crash.*.log

# Local input values (may contain secrets)
*.tfvars
*.tfvars.json
!*.tfvars.example

# Terraform plan outputs
*.tfplan
tfplan

# Editor / operating system
.DS_Store
Thumbs.db

# DO NOT ignore .terraform.lock.hcl in root configurations.

# Reusable module: the calling configuration owns the lock file
.terraform.lock.hcl
